ANTHROPIC_API_KEY=your-api-key-here

# Set at build time when this app is mounted below another site.
# NEXT_PUBLIC_BASE_PATH=/arc

# Production option: proxy chat requests to the persistent container running this repo.
# Omit for local development, where the Agent SDK runs inside the Next.js server.
# AGENT_BACKEND_URL=https://your-agent-worker.example.com

# Set on that worker when its artifacts are displayed by a frontend mounted at /arc.
# ARC_PUBLIC_BASE_PATH=/arc
